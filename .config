# Target System - Qualcomm IPQ807x
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_asus_rt-ax89x=y

# NSS Offloading Modules
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nrassoc=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-tls=y

# LuCI Web Interface
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-openwrt-2020=y

# Chinese Language Support
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-system-zh-cn=y
CONFIG_PACKAGE_luci-i18n-network-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dhcp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wireless-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y
CONFIG_PACKAGE-luci-i18n-commands-zh-cn=y
CONFIG_PACKAGE-luci-i18n-ttyd-zh-cn=y

# Basic System Packages
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE-coreutils-nohup=y
CONFIG_PACKAGE-bash=y
CONFIG_PACKAGE-curl=y
CONFIG_PACKAGE-opkg=y
CONFIG_PACKAGE-wget=y
CONFIG_PACKAGE-tmux=y
CONFIG_PACKAGE-nano=y
CONFIG_PACKAGE-zsh=y

# USB Support
CONFIG_PACKAGE-usb-modeswitch=y
CONFIG_PACKAGE-usb-net=y
CONFIG_PACKAGE-usb-net-rtl8152=y
CONFIG_PACKAGE-usb-storage=y
CONFIG_PACKAGE-kmod-usb-ohci=y
CONFIG_PACKAGE-kmod-usb-uhci=y
CONFIG_PACKAGE-kmod-usb2=y
CONFIG_PACKAGE-kmod-usb3=y
CONFIG_PACKAGE-kmod-usb-storage=y
CONFIG_PACKAGE-kmod-usb-storage-uas=y

# Filesystem Support
CONFIG_PACKAGE-e2fsprogs=y
CONFIG_PACKAGE-fdisk=y
CONFIG_PACKAGE-lsblk=y
CONFIG_PACKAGE-block-mount=y

# WiFi Support
CONFIG_PACKAGE-kmod-ath11k=y
CONFIG_PACKAGE-kmod-ath11k-pci=y
CONFIG_PACKAGE-kmod-cfg80211=y
CONFIG_PACKAGE-kmod-mac80211=y

# Network Tools
CONFIG_PACKAGE-tcpdump=y
CONFIG_PACKAGE-iperf3=y
CONFIG_PACKAGE-nano=y
CONFIG_PACKAGE-fullconenat=y
CONFIG_PACKAGE-nlbwmon=y
CONFIG_PACKAGE-sqm-scripts=y

# IPv6 Support
CONFIG_PACKAGE-odhcp6c=y
CONFIG_PACKAGE-odhcpd-ipv6only=y
CONFIG_PACKAGE-6in4=y

# Firewall
CONFIG_PACKAGE-firewall=y
CONFIG_PACKAGE-firewall4=y
CONFIG_PACKAGE-nftables=y

# Additional Tools
CONFIG_PACKAGE-ttyd=y
CONFIG_PACKAGE-btop=y
CONFIG_PACKAGE-hd-idle=y

# Image Options
CONFIG_TARGET_ROOTFS_PARTSIZE=128
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=1024
